# ==========================================
# AGENTIC RAG - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your keys.
# ==========================================

# --- PRIMARY LLM (Google Gemini) ---
# Massive context window, highly capable reasoning.
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-key-here

# --- AGENT TOOLS (Web Search) ---
# Required for the agent to search the live internet.
# Get a free key at: https://tavily.com/
TAVILY_API_KEY=tvly-your-api-key-here

# ==========================================
# OPTIONAL / FALLBACK FREE APIS
# ==========================================

# --- HIGH-SPEED LLM (Groq) ---
# Ultra-low latency inference using LPUs (Llama 3, Mixtral).
# Get a free key at: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_groq_key_here

# --- ALL-IN-ONE LLM HUB (OpenRouter) ---
# Access dozens of free open-source models with one key.
# Get a free key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# --- ADVANCED RERANKING (Cohere) ---
# Industry-standard reranking to improve RAG search accuracy.
# Get a free key at: https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=your-cohere-key-here

# --- LOCAL LLM (Ollama) ---
# 100% private, offline LLM execution. No key required.
OLLAMA_BASE_URL=http://localhost:11434
